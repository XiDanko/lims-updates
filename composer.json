{
    "name": "xidanko/lims",
    "type": "project",
    "description": "Lab information management system.",
    "keywords": ["lims", "lab"],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "appstract/laravel-opcache": "^4.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^3.0",
        "propaganistas/laravel-phone": "^6.0",
        "setasign/fpdf": "^1.0",
        "setasign/fpdi": "^2.0",
        "spatie/laravel-permission": "^7.0",
        "xidanko/auto-installer": "^1.0",
        "xidanko/query-filter": "^1.0",
        "xidanko/update-manager": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.0",
        "laravel/boost": "^2.0",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": ["app/helpers.php"]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --force"
        ],
        "post-files-update-cmd": [
            "composer update --no-dev --optimize-autoloader --no-interaction",
            "@php artisan optimize:clear",
            "@php artisan opcache:clear",
            "@php artisan permission:sync",
            "@php artisan setting:sync",
            "@php artisan optimize",
            "@php artisan opcache:compile"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
