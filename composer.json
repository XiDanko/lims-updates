{
    "name": "xidanko/lims",
    "type": "project",
    "description": "Lab information management system.",
    "keywords": ["lims", "lab"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "ext-zend-opcache": "*",
        "appstract/laravel-opcache": "^4.0",
        "archtechx/enums": "^0.3.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.8",
        "propaganistas/laravel-phone": "^5.3",
        "rennokki/laravel-eloquent-query-cache": "^3.6",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.3",
        "spatie/laravel-permission": "^6.3.0",
        "xidanko/auto-installer": "^1.3.0",
        "xidanko/query-filter": "^1.0.1",
        "xidanko/update-manager": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": ["app/helpers.php"]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --force"
        ],
        "post-files-update-cmd": [
            "composer update --no-dev --optimize-autoloader --no-interaction",
            "@php artisan optimize:clear",
            "@php artisan opcache:clear",
            "@php artisan permission:sync",
            "@php artisan setting:sync",
            "@php artisan optimize",
            "@php artisan opcache:compile"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
